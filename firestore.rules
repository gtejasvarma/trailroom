rules_version = '2';
// Clients read their own consent, jobs and pose sets. They write nothing: every write goes
// through a server route using the Admin SDK (which bypasses these rules). Everything else,
// including photos, spend and spendLog, is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /consents/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // get by id, and list/queries only when the query is constrained to the caller's uid.
    match /jobs/{jobId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /poseSets/{setId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Labels the caller follows. Read your own; every write goes through /api/follows.
    match /follows/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Phase D: lists, asks (with their votes) and inbox entries are server-only. Clients read
    // them through /api/lists, /api/asks and /api/inbox; the public vote page reaches an ask only
    // through /api/ask/[token], never Firestore. Explicit so a later edit cannot loosen them by
    // accident.
    match /lists/{listId} {
      allow read, write: if false;
    }

    match /asks/{askId} {
      allow read, write: if false;

      match /votes/{voterKey} {
        allow read, write: if false;
      }
    }

    match /inbox/{uid}/asks/{askId} {
      allow read, write: if false;
    }

    // Phase E: the record that someone pressed "Go to <label>" and whether it arrived. Server-only;
    // the app reads it through /api/purchases. Explicit so a later edit cannot loosen it.
    match /purchases/{purchaseId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
