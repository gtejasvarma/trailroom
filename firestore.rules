rules_version = '2';
// Clients read their own consent, jobs and pose sets. They write nothing: every write goes
// through a server route using the Admin SDK (which bypasses these rules). Everything else,
// including photos, spend and spendLog, is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /consents/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // get by id, and list/queries only when the query is constrained to the caller's uid.
    match /jobs/{jobId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /poseSets/{setId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Labels the caller follows. Read your own; every write goes through /api/follows.
    match /follows/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
